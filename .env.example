# Kopieer naar .env:  cp .env.example .env   (nooit .env committen)

# --- Applicatie ---
APP_NAME="NL Dienst Toeslagen"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080
# Leeg laten = wordt bij eerste start automatisch gegenereerd en bewaard in het storage-volume
APP_KEY=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# --- Database (MySQL container "db") ---
DB_DATABASE=toeslagen
DB_USERNAME=toeslagen
DB_PASSWORD=verander_mij
DB_ROOT_PASSWORD=verander_mij_root

# --- Overig ---
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stderr
MAIL_MAILER=log
